AMO_HOME=~/.agent-memory-orchestrator
AMO_DB_PATH=.data/agent_memory.db
AMO_EXPORT_DIR=exports
AMO_LOCAL_ONLY=true
AMO_MCP_TRANSPORT=stdio
AMO_MCP_HOST=127.0.0.1
AMO_MCP_PORT=8765
AMO_EMBEDDING_DIMS=256
AMO_EMBEDDING_MODEL=BAAI/bge-m3
AMO_RERANKER_MODEL=BAAI/bge-reranker-base
AMO_VECTOR_BACKEND=auto
AMO_APPROVAL_MODE=manual
AMO_OWNER_USER_ID=local
AMO_WORKSPACE_ID=local
AMO_PROJECT_ID=default
AMO_VISIBILITY_SCOPE=private
AMO_SENSITIVITY_LEVEL=normal
AMO_CONSENSUS_THRESHOLD=0.70
AMO_MAX_REVIEW_ROUNDS=5

# GraphRAG V1 runtime
AMO_GRAPH_BACKEND=kuzu
AMO_GRAPH_PATH=.graph/amo.kuzu
AMO_EVIDENCE_DIR=.evidence
AMO_QWEN_RUNTIME=ollama
AMO_QWEN_MODEL=qwen3:1.7b
AMO_QWEN_ENDPOINT=http://127.0.0.1:11434
AMO_QWEN_TIMEOUT_SECONDS=20
AMO_QWEN_PLANNER_TIMEOUT_SECONDS=8
AMO_QWEN_EXTRACT_TIMEOUT_SECONDS=25
AMO_QWEN_COMPRESS_TIMEOUT_SECONDS=12
AMO_QWEN_NUM_CTX=2048
AMO_DRAIN_MAX_WINDOWS_PER_RUN=3
