AMO_HOME=.
AMO_DB_PATH=.data/agent_memory.db
AMO_EXPORT_DIR=exports
AMO_LOCAL_ONLY=true
AMO_MCP_TRANSPORT=stdio
AMO_MCP_HOST=127.0.0.1
AMO_MCP_PORT=8765
AMO_EMBEDDING_DIMS=256
AMO_EMBEDDING_MODEL=BAAI/bge-m3
AMO_RERANKER_MODEL=BAAI/bge-reranker-base
AMO_VECTOR_BACKEND=auto
AMO_APPROVAL_MODE=manual
AMO_OWNER_USER_ID=local
AMO_WORKSPACE_ID=local
AMO_PROJECT_ID=default
AMO_VISIBILITY_SCOPE=private
AMO_SENSITIVITY_LEVEL=normal
AMO_CONSENSUS_THRESHOLD=0.70
AMO_MAX_REVIEW_ROUNDS=5
