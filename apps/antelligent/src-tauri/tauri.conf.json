{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antelligent",
  "version": "0.1.0",
  "identifier": "com.agentmemoryorchestrator.antelligent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "bubble",
        "title": "Antelligent",
        "url": "index.html#bubble",
        "width": 64,
        "height": 74,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "panel",
        "title": "Antelligent Control",
        "url": "index.html#panel",
        "width": 980,
        "height": 820,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
